# GitHub Personal Access Token (用于读取仓库)
# 建议配置，否则 GitHub API 请求将受到每小时 60 次的严格限制
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxx

# ========================================
# LLM Provider 配置 (默认使用 Kimi)
# ========================================
# 选择 LLM 提供商: kimi, deepseek, 或 groq
LLM_PROVIDER=kimi

# --- Kimi (GitCode) 配置 (默认) ---
GITCODE_API_KEY=your_gitcode_api_key
# 可选：自定义模型名称和 API 地址
# GITCODE_MODEL_NAME=moonshotai/Kimi-K2-Instruct-0905
# GITCODE_BASE_URL=https://api-ai.gitcode.com/v1

# --- DeepSeek 配置 (可选) ---
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxx
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MODEL_NAME=deepseek-chat

# --- Groq 配置 (可选) ---
# GROQ_API_KEY=your_groq_api_key
# MODEL_NAME=groq/compound
# GROQ_COMPOUND_CUSTOM={"models": [...]}

# ========================================
# Embedding 配置 (向量化)
# ========================================
# SiliconFlow API Key (用于 BGE-M3 Embedding)
SILICON_API_KEY=sk-xxxxxxxxxxxxxxx

# ========================================
# 服务配置 (可选)
# ========================================
# HOST=127.0.0.1
# PORT=8000
